# Copy this file to .env and fill in every value before running docker compose.
#   cp .env.example .env
#
# Generate the secrets with:
#   openssl rand -hex 32   (JWT_SECRET)
#   openssl rand -hex 24   (database passwords)
#
# Passwords are injected into a connection URL, so stick to letters and digits:
# characters such as @ : / # would break DATABASE_URL.

# --- Database (MariaDB container) --------------------------------------------
MARIADB_DATABASE=loto
MARIADB_USER=loto
MARIADB_PASSWORD=change_me_application_password
MARIADB_ROOT_PASSWORD=change_me_root_password

# --- Application --------------------------------------------------------------
# Signing key for session cookies. Changing it logs everybody out.
JWT_SECRET=change_me_with_openssl_rand_hex_32

# Initial administrator, created on first start only. An existing account is
# never modified, so a password changed from the admin panel survives restarts.
ADMIN_USERNAME=thomas
ADMIN_PASSWORD=change_me_admin_password

# Host port the app is published on.
# Behind the caddy profile, restrict it to the host: APP_PORT=127.0.0.1:3000
APP_PORT=3000

# --- HTTPS reverse proxy (only for `docker compose --profile proxy up -d`) -----
# DOMAIN must already resolve to this server (A / AAAA record).
DOMAIN=loto.example.com
ACME_EMAIL=admin@example.com

# --- Local development without Docker ------------------------------------------
# Uncomment and point to a reachable MariaDB instance. Inside compose the URL is
# built automatically from the MARIADB_* values above.
# DATABASE_URL=mysql://loto:change_me_application_password@127.0.0.1:3306/loto
